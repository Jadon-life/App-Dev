{
  "name": "cryslearn",
  "version": "1.0.0",
  "private": true,
  "description": "CrysLearn — Learn with clarity. Score with confidence.",
  "workspaces": [
    "web",
    "mobile",
    "shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=web",
    "build:web": "npm run build --workspace=web",
    "lint": "npm run lint --workspace=web && npm run lint --workspace=cryslearn-mobile && eslint shared --ext .ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "tsx --tsconfig web/tsconfig.json --test web/tests/*.test.ts web/src/lib/*.test.ts mobile/tests/*.test.ts",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "typecheck:mobile": "tsc --noEmit -p mobile/tsconfig.json",
    "test:e2e": "bash scripts/test-e2e.sh",
    "test:db": "bash scripts/test-database.sh",
    "test:release": "python3 -m unittest discover -s scripts/tests -v",
    "check:mobile-sdk": "node scripts/check-mobile-sdk.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "semver": "^7.8.5",
    "tsx": "^4.23.15",
    "typescript": "^5.3.0"
  },
  "overrides": {
    "postcss": "^8.5.30",
    "@expo/server": "0.4.4",
    "tar": "7.5.22"
  }
}
