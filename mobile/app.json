{
  "expo": {
    "name": "CrysLearn",
    "slug": "cryslearn",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "cryslearn",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#102528"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cryslearn.app"
    },
    "android": {
      "package": "com.cryslearn.app"
    },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
