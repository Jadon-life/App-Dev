# Public project configuration only. Never add a service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional HTTPS origin of your deployed CrysLearn web app. Used to open
# practice sessions and payments in the browser. HTTP is allowed only for localhost.
EXPO_PUBLIC_WEB_URL=

# Standard Expo 50 native Google sign-in opens the web app.
# In-app Google requires a runtime with secure WebCrypto PKCE support.
# For that flow allow cryslearn://auth/callback in Supabase Auth settings
# and use a development/production build with the cryslearn URL scheme.
